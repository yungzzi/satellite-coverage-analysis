# Python
__pycache__/
*.py[cod]
.venv/
venv/

# IDE
.vscode/
.idea/

# 原始轨道数据（可重新下载，不入库）
data/raw/

# 验证用的网页/TLE 快照（可重新下载，不入库；结果 CSV 入库）
output/validation/*.html
output/validation/*.tle

# 查询工具导出的 Excel（用户生成，不入库）
output/*.xlsx

# 结果输出目录（生成物，不入库；随时可重新生成）
output/

# 用户自己的配置文件（模板 config.example.toml 入库）
config.toml

# 系统文件
Thumbs.db
.DS_Store
